# Copy to .env and fill with local-only values. NEVER commit a real .env.

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change_me_before_running
GRAFANA_ADMIN_PASSWORD=change_me_before_running

# Optional: enable deterministic development seeding (demo organization)
# and a development administrator account. Development only; leave unset
# elsewhere. The seeder reads Seed:* configuration, e.g. via
# environment variables when running locally:
#   Seed__Development=true
#   Seed__AdminEmail=admin@atlas.local
#   Seed__AdminPassword=use-a-local-only-password
#   Seed__AdminOrganizationId=11111111-1111-1111-1111-111111111111

# Optional: OAuth/OIDC federation. ATLAS binds and validates this section so a
# partial configuration fails startup instead of being silently ignored, but
# the OpenIdConnect handler itself is a marked extension point — external
# sign-in stays disabled until it is registered (see docs/security.md).
# Leave everything empty to run with local cookie + API-key authentication.
#   Oidc__Authority=https://login.example.com/tenant/v2.0
#   Oidc__ClientId=
#   Oidc__ClientSecret=
#   Oidc__DisplayName=Single sign-on

# Optional: Anthropic API key for the AI operations assistant's prose
# generation. Without it the assistant still works but returns
# deterministic evidence-only summaries.
# AI__AnthropicApiKey=
