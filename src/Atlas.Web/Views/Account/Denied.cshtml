@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<section class="atlas-toolbar">
    <div><div class="atlas-kicker">ATLAS / ACCESS</div><h1>ACCESS DENIED</h1></div>
</section>

<section class="atlas-dashboard-grid">
    <article class="atlas-panel atlas-panel--inset atlas-wide">
        <div class="atlas-panel-header"><h2>FORBIDDEN</h2><span class="atlas-badge">403</span></div>
        <p class="atlas-status-text">Your authenticated identity does not hold the role or organization scope required for this resource.</p>
        <p class="atlas-note">No information about the target resource is disclosed by this response. Request access from your organization administrator if you believe this is incorrect.</p>
        <a class="atlas-button" href="/">RETURN TO COMMAND CENTER</a>
    </article>
</section>
