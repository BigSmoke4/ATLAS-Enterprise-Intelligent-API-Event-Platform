@using Atlas.Modules.Audit.Domain
@model AuditViewModel
@{
    ViewData["Title"] = "Audit Trail";
    ViewData["Page"] = "audit";
    Layout = "_Layout";
}

<section data-atlas-command data-cadence="0">
    <div class="atlas-page-head">
        <div class="atlas-page-head__titles">
            <h1>Audit Trail</h1>
            <span class="atlas-kicker">
                Append-only record of security and operational events · @Model.Entries.Count entr@(Model.Entries.Count == 1 ? "y" : "ies") shown
            </span>
        </div>
        <div class="atlas-action-bar">
            <span class="atlas-freshness">Read <span data-atlas-updated>—</span></span>
            <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-atlas-refresh>REFRESH</button>
        </div>
    </div>

    <div class="atlas-alert atlas-alert--info">
        There is no update or delete path for audit entries — not in this console, not in the API, and not in the persistence layer
        (<span class="atlas-mono">AuditDbContext</span> rejects modified or deleted state). Entries record actor, tenant, action, resource,
        correlation id and source address; before/after JSON is captured only where a change has a meaningful representation.
        Reading the trail requires the <span class="atlas-mono">AuditRead</span> capability and is scoped to your organization.
    </div>

    @if (!Model.HasOrganizationContext)
    {
        <div class="atlas-panel">
            <div class="atlas-panel__body">
                <partial name="_Empty" model="@("No audit entries available.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Your account is not scoped to an organization, so the trail cannot be filtered to a tenant." }, { "Glyph", "≡" } }' />
            </div>
        </div>
    }
    else
    {
        <div class="atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Entries</span>
                <span class="atlas-freshness">Filters are substring matches applied server-side; the table below is the last successful read.</span>
            </div>
            <div class="atlas-panel__body">
                <div class="atlas-table-toolbar">
                    <label class="atlas-label" for="audit-action">Action</label>
                    <input class="atlas-input atlas-input--sm" id="audit-action" data-audit-filter="action" value="@Model.ActionFilter" placeholder="dead_letter.replay" />
                    <label class="atlas-label" for="audit-resource">Resource type</label>
                    <input class="atlas-input atlas-input--sm" id="audit-resource" data-audit-filter="resourceType" value="@Model.ResourceTypeFilter" placeholder="PolicyRule" />
                    <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-audit-reset>CLEAR</button>
                </div>

                <div class="atlas-table-wrap">
                    <table class="atlas-table atlas-table--compact atlas-table--zebra" data-atlas-table>
                        <thead>
                            <tr>
                                <th>Recorded (UTC)</th>
                                <th>Actor</th>
                                <th>Action</th>
                                <th>Resource</th>
                                <th>Resource id</th>
                                <th>Correlation</th>
                                <th>Source address</th>
                            </tr>
                        </thead>
                        <tbody data-audit-body>
                            @if (Model.Entries.Count == 0)
                            {
                                <tr class="atlas-empty-row"><td colspan="7">No audit entries match this filter.</td></tr>
                            }
                            else
                            {
                                foreach (AuditEntry entry in Model.Entries)
                                {
                                    <tr>
                                        <td class="atlas-mono atlas-small">@entry.CreatedAtUtc.ToString("u")</td>
                                        <td>@(string.IsNullOrWhiteSpace(entry.ActorDisplay) ? "system" : entry.ActorDisplay)</td>
                                        <td class="atlas-mono">@entry.Action</td>
                                        <td>@entry.ResourceType</td>
                                        <td class="atlas-mono atlas-small">@entry.ResourceId</td>
                                        <td class="atlas-mono atlas-small">@entry.CorrelationId</td>
                                        <td class="atlas-mono atlas-small">@(entry.IpAddress ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</section>

<script type="application/json" id="audit-bootstrap">@Html.Raw(WebJson.Serialize(new { organizationId = Model.OrganizationId, canRead = Model.CanRead }))</script>
