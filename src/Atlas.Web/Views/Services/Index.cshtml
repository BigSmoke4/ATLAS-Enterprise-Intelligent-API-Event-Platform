@using Atlas.Modules.ServiceRegistry.Application
@model IReadOnlyList<ServiceStatusDto>
@{
    ViewData["Title"] = "Services";
    Layout = "_Layout";
}

<section class="atlas-panel">
    <h1>SERVICE HEALTH</h1>

    @if (Model.Count == 0)
    {
        <p class="atlas-status-text">No telemetry available. Your organization has no registered services yet — register one via POST /api/v1/services (Role: SRE).</p>
    }
    else
    {
        <table class="atlas-table">
            <thead>
                <tr><th>Service</th><th>Health</th><th>Instances</th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td><span class="atlas-badge atlas-badge--@s.AggregateHealth.ToString().ToLowerInvariant()">@s.AggregateHealth</span></td>
                    <td>@s.HealthyInstanceCount / @s.InstanceCount healthy</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
