@using Atlas.Modules.Reliability.Domain
@model ReliabilityViewModel
@{
    ViewData["Title"] = "Reliability";
    ViewData["Page"] = "reliability";
    Layout = "_Layout";
    var open = Model.CircuitBreakers.Count(kv => kv.Value == CircuitState.Open);
    var halfOpen = Model.CircuitBreakers.Count(kv => kv.Value == CircuitState.HalfOpen);
}

<section data-atlas-command data-cadence="15000">
    <div class="atlas-page-head">
        <div class="atlas-page-head__titles">
            <h1>Reliability Controls</h1>
            <span class="atlas-kicker">
                Circuit breaker states, distributed rate limiting and resilience policy · @open open · @halfOpen half-open
            </span>
        </div>
        <div class="atlas-action-bar">
            <span class="atlas-freshness">Snapshot <span data-atlas-updated>—</span></span>
            <button type="button" class="atlas-button atlas-button--primary atlas-button--sm" data-atlas-refresh>REFRESH</button>
        </div>
    </div>

    <div class="atlas-grid">
        <div class="atlas-col-7 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Circuit breakers (live in-process state)</span>
                <span class="atlas-freshness">Sampling window + minimum volume per breaker · state changes are exported as metrics</span>
            </div>
            <div class="atlas-panel__body">
                @if (Model.CircuitBreakers.Count == 0)
                {
                    <partial name="_Empty" model="@("No circuit breakers exercised yet.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Breakers appear here after the first guarded downstream call. An empty table means nothing has been called — it is not a report that everything is healthy." }, { "Glyph", "◍" } }' />
                }
                else
                {
                    <div class="atlas-table-wrap">
                        <table class="atlas-table atlas-table--compact atlas-table--zebra" data-atlas-table>
                            <thead>
                                <tr><th>Downtream key</th><th>State</th><th>Signal</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var breaker in Model.CircuitBreakers.OrderBy(kv => kv.Key, StringComparer.Ordinal))
                                {
                                    var tone = ReliabilityViewModel.ToneFor(breaker.Value);
                                    <tr>
                                        <td class="atlas-mono">@breaker.Key</td>
                                        <td><span class="atlas-badge atlas-badge--@tone">@breaker.Value.ToString().ToUpperInvariant()</span></td>
                                        <td><span class="atlas-signal atlas-signal--@tone" aria-hidden="true"></span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="atlas-col-5 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head"><span class="atlas-panel__title">Rate limiting</span></div>
            <div class="atlas-panel__body">
                <div class="atlas-metric-strip">
                    <div class="atlas-metric">
                        <span class="atlas-metric__label">Backend</span>
                        <span class="atlas-metric__value atlas-metric__value--small">@Model.RateLimiterBackend</span>
                    </div>
                </div>
                <ul class="atlas-list">
                    <li class="atlas-list__item"><span class="atlas-label">Algorithms</span><span class="atlas-freshness">token bucket, fixed window, sliding window, leaky bucket</span></li>
                    <li class="atlas-list__item"><span class="atlas-label">Scopes</span><span class="atlas-freshness">IP, user, API key, tenant, endpoint, global</span></li>
                    <li class="atlas-list__item"><span class="atlas-label">Atomicity</span><span class="atlas-freshness">single Lua script per decision — correct across nodes, no read-modify-write race</span></li>
                </ul>
                <p class="atlas-freshness">
                    Limits come from route policy (per API version or route). The decision — and the active limit — is recorded in request
                    telemetry, so the Observability page can show 429s against the limit that produced them.
                </p>
            </div>
        </div>

        <div class="atlas-col-6 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head"><span class="atlas-panel__title">Timeouts, retries and backoff</span></div>
            <div class="atlas-panel__body">
                <ul class="atlas-list">
                    <li class="atlas-list__item"><span class="atlas-label">Route timeout</span><span class="atlas-freshness">per-route timeout from the configured route policy; enforced by a linked cancellation token</span></li>
                    <li class="atlas-list__item"><span class="atlas-label">Retries</span><span class="atlas-freshness">bounded per route with exponential backoff and jitter; retries are recorded, not hidden</span></li>
                    <li class="atlas-list__item"><span class="atlas-label">Fallback</span><span class="atlas-freshness">an open circuit returns a ProblemDetails 503 with Retry-After instead of queueing work</span></li>
                    <li class="atlas-list__item"><span class="atlas-label">Kafka outage</span><span class="atlas-freshness">publisher surfaces the outage to the caller; consumers pause and resume on broker recovery</span></li>
                </ul>
            </div>
        </div>

        <div class="atlas-col-6 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head"><span class="atlas-panel__title">Health probes</span></div>
            <div class="atlas-panel__body">
                <ul class="atlas-probe-list">
                    <li class="atlas-probe"><span class="atlas-lamp atlas-lamp--idle" aria-hidden="true"></span><span class="atlas-mono">/health</span><span class="atlas-freshness">aggregate report (self, db, redis, kafka)</span></li>
                    <li class="atlas-probe"><span class="atlas-lamp atlas-lamp--idle" aria-hidden="true"></span><span class="atlas-mono">/health/live</span><span class="atlas-freshness">liveness — the process is running</span></li>
                    <li class="atlas-probe"><span class="atlas-lamp atlas-lamp--idle" aria-hidden="true"></span><span class="atlas-mono">/health/ready</span><span class="atlas-freshness">readiness — dependencies reachable; drives rolling deploys</span></li>
                </ul>
                <p class="atlas-freshness">
                    Probe status is not polled from the browser: the platform's own health endpoints are the source of truth for orchestrators,
                    and the Overview panel shows the last recorded result rather than inventing a colour.
                </p>
            </div>
        </div>
    </div>
</section>
