@model DashboardViewModel
@{
    ViewData["Title"] = "Command Centre";
    ViewData["Page"] = "dashboard";
    ViewData["WindowMinutes"] = 60;
    Layout = "_Layout";
    var healthTone = Model.ServiceUnhealthy + Model.ServiceUnavailable > 0 ? "bad"
        : Model.ServiceDegraded > 0 ? "warn" : Model.ServiceTotal > 0 ? "ok" : "idle";
}

<section class="atlas-command" data-atlas-command data-cadence="60000">
    <div class="atlas-command__head">
        <div class="atlas-page-head__titles">
            <div class="atlas-page-head__title">
                <h1>Command Centre</h1>
                <span class="atlas-badge @(healthTone == "ok" ? "atlas-badge--ok" : healthTone == "warn" ? "atlas-badge--warn" : healthTone == "bad" ? "atlas-badge--bad" : "atlas-badge--neutral")">
                    @(healthTone == "idle" ? "NO TELEMETRY" : healthTone.ToUpperInvariant())
                </span>
            </div>
            <span class="atlas-kicker">
                Organization @(Model.HasOrganizationContext ? Model.ServiceTotal + " services under management" : "context required")
            </span>
        </div>
        <div class="atlas-action-bar">
            <span class="atlas-freshness">Updated <span data-atlas-updated>—</span></span>
            <label class="atlas-field__label" for="dashboard-cadence">Cadence</label>
            <select class="atlas-select atlas-input--sm" id="dashboard-cadence" data-atlas-cadence>
                <option value="15000">15 s</option>
                <option value="30000">30 s</option>
                <option value="60000" selected>60 s</option>
                <option value="0">manual</option>
            </select>
            <button type="button" class="atlas-button atlas-button--primary atlas-button--sm" data-atlas-refresh>REFRESH</button>
        </div>
    </div>

    @if (!Model.HasOrganizationContext)
    {
        <div class="atlas-command__readouts">
            <div class="atlas-command__readout">
                <span class="atlas-metric__label">Organization context</span>
                <span class="atlas-metric__value">—</span>
                <span class="atlas-metric__hint">Your account is not scoped to an organization, so no tenant telemetry is shown.</span>
            </div>
        </div>
    }
    else
    {
        @* Headline readouts are refreshed from /api/v1/metrics/summary — the
           server-rendered dash means "no reading yet", never zero traffic. *@
        <div class="atlas-command__readouts">
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Requests / sec</span>
                <span class="atlas-metric__value" data-metric="requestsPerSecond">—</span>
                <span class="atlas-metric__hint">Last 60 minutes · <span data-telemetry-state>No telemetry available.</span></span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Requests</span>
                <span class="atlas-metric__value" data-metric="requests">—</span>
                <span class="atlas-metric__hint">Recorded request telemetry</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Error rate (5xx)</span>
                <span class="atlas-metric__value" data-metric="errorRate">—</span>
                <span class="atlas-metric__hint">Server errors ÷ recorded requests</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">P50 latency</span>
                <span class="atlas-metric__value atlas-metric__value--small" data-metric="p50">—</span>
                <span class="atlas-metric__hint">Histogram bucket boundary</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">P95 latency</span>
                <span class="atlas-metric__value atlas-metric__value--small" data-metric="p95">—</span>
                <span class="atlas-metric__hint">SLO target: &lt; 300 ms</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">P99 latency</span>
                <span class="atlas-metric__value atlas-metric__value--small" data-metric="p99">—</span>
                <span class="atlas-metric__hint">Histogram bucket boundary</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Services healthy</span>
                <span class="atlas-metric__value atlas-metric__value--small">@Model.ServiceHealthy / @Model.ServiceTotal</span>
                <div class="atlas-distribution" role="img" aria-label="Service health distribution">
                    @{
                        var total = Math.Max(1, Model.ServiceTotal);
                    }
                    <span class="atlas-distribution__part atlas-distribution__part--ok" style="flex:@Model.ServiceHealthy"></span>
                    <span class="atlas-distribution__part atlas-distribution__part--warn" style="flex:@Model.ServiceDegraded"></span>
                    <span class="atlas-distribution__part atlas-distribution__part--bad" style="flex:@(Model.ServiceUnhealthy + Model.ServiceUnavailable)"></span>
                    <span class="atlas-distribution__part atlas-distribution__part--idle" style="flex:@(Math.Max(0, total - Model.ServiceTotal))"></span>
                </div>
                <span class="atlas-metric__hint">@Model.ServiceDegraded degraded · @Model.ServiceUnhealthy unhealthy · @Model.ServiceUnavailable unavailable</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Active incidents</span>
                <span class="atlas-metric__value" data-metric="activeIncidents">@Model.ActiveIncidents.Count</span>
                <span class="atlas-metric__hint">Detected → Mitigating</span>
            </div>
            <div class="atlas-command__readout atlas-metric">
                <span class="atlas-metric__label">Dead-letter backlog</span>
                <span class="atlas-metric__value atlas-metric__value--small @(Model.DeadLetterCount > 0 ? "atlas-metric__value--warn" : "")">@Model.DeadLetterCount</span>
                <a class="atlas-metric__hint" href="/Events">Inspect event pipelines →</a>
            </div>
        </div>

        <div class="atlas-status-banner @(healthTone == "bad" ? "atlas-status-banner--bad" : healthTone == "warn" ? "atlas-status-banner--warn" : "")">
            <span class="atlas-status-banner__text">
                @(healthTone switch
                {
                    "ok" => "All systems nominal",
                    "warn" => "Degraded service health detected",
                    "bad" => "Service health critical — open incidents required",
                    _ => "No telemetry available"
                })
            </span>
            <span class="atlas-freshness" data-dashboard-status></span>
        </div>
    }

    <div class="atlas-panel__body atlas-grid">
        <div class="atlas-col-8 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Traffic · requests vs 5xx vs P95</span>
                <span class="atlas-panel__actions atlas-freshness">5-minute buckets · first bucket <span data-telemetry-first>—</span></span>
            </div>
            <div class="atlas-panel__body">
                <div class="atlas-chart" data-atlas-chart="traffic">
                    <div class="atlas-chart__plot atlas-chart__plot--tall">
                        <canvas aria-label="Request volume, server errors and P95 latency over time" role="img"></canvas>
                        <div class="atlas-chart__tooltip"></div>
                    </div>
                    <div class="atlas-chart__meta">
                        <span class="atlas-legend">
                            <span class="atlas-legend__item"><span class="atlas-legend__swatch atlas-legend__swatch--info"></span>requests</span>
                            <span class="atlas-legend__item"><span class="atlas-legend__swatch atlas-legend__swatch--bad"></span>5xx</span>
                            <span class="atlas-legend__item"><span class="atlas-legend__swatch atlas-legend__swatch--warn"></span>p95 (ms)</span>
                        </span>
                        <span class="atlas-chart__readout" data-chart-readout>Last bucket <span data-telemetry-last>—</span></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="atlas-col-4 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Active incidents</span>
                <a class="atlas-button atlas-button--ghost atlas-button--sm" href="/Incidents">BOARD</a>
            </div>
            <div class="atlas-panel__body">
                <div class="atlas-inset atlas-inset--scroll" data-incident-list>
                    @if (Model.ActiveIncidents.Count == 0)
                    {
                        <div class="atlas-empty atlas-empty--inline">
                            <span class="atlas-empty__title">No active incidents</span>
                        </div>
                    }
                    else
                    {
                        foreach (var incident in Model.ActiveIncidents)
                        {
                            <div class="atlas-incident-row">
                                <span class="atlas-severity atlas-severity--@(incident.Severity.ToLowerInvariant())">@incident.Severity</span>
                                <div class="atlas-incident-row__title">
                                    <span>@incident.Title</span>
                                    <span class="atlas-incident-row__meta">started @incident.StartedAtUtc.ToString("u")</span>
                                </div>
                                <span class="atlas-badge atlas-badge--bad">@incident.Status</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="atlas-col-7 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">SLO / error budget</span>
                <a class="atlas-button atlas-button--ghost atlas-button--sm" href="/Observability">DETAIL</a>
            </div>
            <div class="atlas-panel__body">
                @if (Model.Slos.Count == 0)
                {
                    <partial name="_Empty" model="@("No telemetry available.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "No SLOs are defined for this organization yet. Define one via POST /api/v1/slo (Role: SRE) — compliance is then derived from live request telemetry." }, { "Glyph", "%" } }' />
                }
                else
                {
                    foreach (var slo in Model.Slos)
                    {
                        var fraction = slo.ErrorBudgetRemainingPercent.HasValue ? slo.ErrorBudgetRemainingPercent.Value / 100 : (double?)null;
                        var tone = fraction is null ? "bad" : fraction > 0.5 ? "ok" : fraction > 0.2 ? "warn" : "bad";
                        <div class="atlas-slo-row">
                            <div class="atlas-slo-row__name">
                                <span>@slo.Name</span>
                                <span class="atlas-freshness">@slo.MetricType · target @slo.TargetValue · @slo.SampleCount sample(s)</span>
                            </div>
                            <span class="atlas-signal atlas-signal--@tone atlas-value">
                                @(slo.CurrentValue.HasValue ? slo.CurrentValue.Value.ToString("0.###") : "—")
                            </span>
                            <div class="atlas-slo-row__bar atlas-bar" data-atlas-bar data-value="@(fraction?.ToString(System.Globalization.CultureInfo.InvariantCulture))" data-tone="@tone">
                                <div class="atlas-bar__fill"></div>
                            </div>
                            <span class="atlas-freshness">
                                @(slo.ErrorBudgetRemainingPercent.HasValue ? slo.ErrorBudgetRemainingPercent.Value.ToString("0.0") + "% budget" : "no budget data")
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="atlas-col-5 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Deployment health</span>
                <a class="atlas-button atlas-button--ghost atlas-button--sm" href="/Deployments">HISTORY</a>
            </div>
            <div class="atlas-panel__body">
                @if (Model.RecentDeployments.Count == 0)
                {
                    <partial name="_Empty" model="@("No deployments recorded.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Record a deployment via POST /api/v1/deployments to enable regression and canary analysis." }, { "Glyph", "↑" } }' />
                }
                else
                {
                    foreach (var deployment in Model.RecentDeployments)
                    {
                        <div class="atlas-deployment-row">
                            <div class="atlas-column" style="gap:2px">
                                <span class="atlas-deployment-row__version">@deployment.Version</span>
                                <span class="atlas-freshness">@deployment.Author · @deployment.DeployedAtUtc.ToString("u")</span>
                            </div>
                            <span class="atlas-env atlas-env--@deployment.Environment.ToLowerInvariant()">@deployment.Environment</span>
                            <span class="atlas-badge @(deployment.Status == "Succeeded" ? "atlas-badge--ok" : deployment.Status == "Failed" ? "atlas-badge--bad" : "atlas-badge--warn")">@deployment.Status</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="atlas-col-6 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Security / operational trail</span>
                <a class="atlas-button atlas-button--ghost atlas-button--sm" href="/Audit">AUDIT</a>
            </div>
            <div class="atlas-panel__body">
                @if (Model.SecurityEvents.Count == 0)
                {
                    <partial name="_Empty" model="@("No audit entries recorded.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Policy, key, replay and configuration changes appear here." }, { "Glyph", "≡" } }' />
                }
                else
                {
                    <ul class="atlas-list">
                        @foreach (var entry in Model.SecurityEvents)
                        {
                            <li class="atlas-list__item">
                                <span class="atlas-mono atlas-small">@entry.Action</span>
                                <span class="atlas-freshness">@entry.ResourceType · @entry.ActorDisplay · @entry.RecordedAtUtc</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="atlas-col-6 atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">AI operations analysis</span>
                <a class="atlas-button atlas-button--ghost atlas-button--sm" href="/AiOps">TOOLS</a>
            </div>
            <div class="atlas-panel__body">
                <div class="atlas-ai-dock">
                    <form class="atlas-row" data-ai-form>
                        <input class="atlas-input" name="question" placeholder="e.g. Why is payment latency elevated?" aria-label="Ask the AI operations assistant" />
                        <button type="submit" class="atlas-button atlas-button--primary">ASK</button>
                    </form>
                    <div class="atlas-chip-row">
                        <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-ai-prompt="Summarise current service health for this organization.">HEALTH SUMMARY</button>
                        <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-ai-prompt="Which SLOs are at risk of breaching their error budget?">SLO RISK</button>
                        <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-ai-prompt="What is the most likely root cause of the latest incident?">ROOT CAUSE</button>
                    </div>
                    <div class="atlas-ai-dock__answer" data-ai-answer>Ask a question — answers cite the ATLAS tool evidence used, and say "Insufficient evidence." when there is none.</div>
                    <div class="atlas-ai-dock__evidence" data-ai-evidence></div>
                    <span class="atlas-freshness" data-bootstrap-note></span>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="application/json" id="dashboard-bootstrap">@Html.Raw(WebJson.Serialize(new { note = "Read tools are tenant-scoped; action tools require PlatformAdmin + explicit confirmation.", windowMinutes = 60 }))</script>
