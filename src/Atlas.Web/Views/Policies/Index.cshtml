@using Atlas.Modules.PolicyEngine.Domain
@model PoliciesViewModel
@{
    ViewData["Title"] = "Policy Engine";
    ViewData["Page"] = "policies";
    Layout = "_Layout";
}

<section data-atlas-command data-cadence="0">
    <div class="atlas-page-head">
        <div class="atlas-page-head__titles">
            <h1>Policy Engine</h1>
            <span class="atlas-kicker">
                Data-only rules (<span class="atlas-mono">field OP value</span> → action). No user-supplied code is ever executed.
            </span>
        </div>
        <div class="atlas-action-bar">
            <span class="atlas-freshness">Read <span data-atlas-updated>—</span></span>
            <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-atlas-refresh>REFRESH</button>
        </div>
    </div>

    <div class="atlas-alert atlas-alert--info">
        Rule changes (create, activate, deactivate, new version) require <span class="atlas-mono">PlatformAdmin</span> and are written to the
        append-only audit log with a correlation id. Evaluation is read-only: a matching rule reports what it <em>would</em> do
        (activate breaker, recommend rollback, raise alert) and never mutates the platform from inside the evaluator.
    </div>

    @if (!Model.HasOrganizationContext)
    {
        <div class="atlas-panel">
            <div class="atlas-panel__body">
                <partial name="_Empty" model="@("No telemetry available.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Your account is not scoped to an organization, so no policies are shown." }, { "Glyph", "§" } }' />
            </div>
        </div>
    }
    else if (Model.Policies.Count == 0)
    {
        <div class="atlas-panel">
            <div class="atlas-panel__body">
                <partial name="_Empty" model="@("No policies defined.")" view-data='new ViewDataDictionary(ViewData) { { "Hint", "Create one via POST /api/v1/policies with conditions such as error_rate > 0.05 and an action. Old versions are deactivated, never deleted." }, { "Glyph", "§" } }' />
            </div>
        </div>
    }
    else
    {
        <div class="atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Rules</span>
                <span class="atlas-freshness">@Model.Policies.Count rule version(s) · active and historical</span>
            </div>
            <div class="atlas-panel__body">
                <div class="atlas-table-wrap">
                    <table class="atlas-table atlas-table--compact atlas-table--zebra" data-atlas-table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Version</th>
                                <th>State</th>
                                <th>Conditions (all must match)</th>
                                <th>Action</th>
                                <th class="atlas-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody data-policies-body>
                            @foreach (PolicyRule rule in Model.Policies)
                            {
                                <tr data-policy-id="@rule.Id">
                                    <td>@rule.Name</td>
                                    <td class="atlas-center atlas-mono">v@rule.Version</td>
                                    <td>
                                        <span class="atlas-badge atlas-badge--@(rule.IsActive ? "ok" : "neutral")">@(rule.IsActive ? "ACTIVE" : "INACTIVE")</span>
                                    </td>
                                    <td>
                                        <div class="atlas-rule">
                                            @foreach (var condition in rule.Conditions)
                                            {
                                                <span class="atlas-tag atlas-mono">
                                                    @condition.FieldName @Operator(condition.Operator) @condition.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <span class="atlas-mono atlas-small">@rule.Action.Type</span>
                                        @if (!string.IsNullOrWhiteSpace(rule.Action.AlertSeverity))
                                        {
                                            <span class="atlas-badge atlas-badge--warn">@rule.Action.AlertSeverity</span>
                                        }
                                    </td>
                                    <td class="atlas-right atlas-nowrap">
                                        @if (rule.IsActive)
                                        {
                                            <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-policy-deactivate="@rule.Id">DEACTIVATE</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-policy-activate="@rule.Id">ACTIVATE</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="atlas-panel atlas-panel--flat">
            <div class="atlas-panel__head">
                <span class="atlas-panel__title">Author a rule</span>
                <span class="atlas-freshness">PlatformAdmin only · creating a rule writes an audit entry</span>
            </div>
            <div class="atlas-panel__body">
                <form class="atlas-form-grid" data-policy-form>
                    <label class="atlas-field">
                        <span class="atlas-field__label">Name</span>
                        <input class="atlas-input" name="name" required placeholder="High error rate on checkout" />
                    </label>
                    <div class="atlas-inset atlas-inset-soft">
                        <span class="atlas-field__label">Conditions — all must match (AND)</span>
                        <div class="atlas-column" data-condition-list></div>
                        <button type="button" class="atlas-button atlas-button--ghost atlas-button--sm" data-add-condition>ADD CONDITION</button>
                    </div>
                    <label class="atlas-field">
                        <span class="atlas-field__label">Action</span>
                        <select class="atlas-select" name="actionType">
                            <option value="RaiseAlert">Raise alert</option>
                            <option value="ActivateCircuitBreaker">Activate circuit breaker</option>
                            <option value="RecommendRollback">Recommend rollback</option>
                        </select>
                    </label>
                    <label class="atlas-field atlas-hidden" data-severity-field>
                        <span class="atlas-field__label">Alert severity</span>
                        <select class="atlas-select" name="alertSeverity">
                            <option value="Info">Info</option>
                            <option value="Warning" selected>Warning</option>
                            <option value="Critical">Critical</option>
                        </select>
                    </label>
                    <div class="atlas-form-actions">
                        <button type="submit" class="atlas-button atlas-button--primary atlas-button--sm">CREATE RULE</button>
                        <span class="atlas-freshness" data-policy-status>
                            Conditions are field/operator/value data. Evaluation is read-only — a matching rule reports the action it would take.
                        </span>
                    </div>
                </form>
            </div>
        </div>
    }
</section>

<script type="application/json" id="policies-bootstrap">@Html.Raw(WebJson.Serialize(new { organizationId = Model.OrganizationId, canManage = User.IsInRole(Atlas.Modules.Identity.Domain.AtlasRoles.PlatformAdmin) }))</script>

@functions {
    private static string Operator(ComparisonOperator op) => op switch
    {
        ComparisonOperator.GreaterThan => ">",
        ComparisonOperator.GreaterThanOrEqual => ">=",
        ComparisonOperator.LessThan => "<",
        ComparisonOperator.LessThanOrEqual => "<=",
        ComparisonOperator.Equal => "==",
        ComparisonOperator.NotEqual => "!=",
        _ => "?"
    };
}
