<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.9.0" />
    <!-- Pinned above the GHSA-4625-4j76-fww9 fix line (>=1.10.0); the rest of
         the OTel packages stay on the 1.9.0 stable line — mixing exporter
         versions is supported, they are independently versioned. -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.12.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.9.0" />
    <!-- This exporter has never shipped a stable release (NuGet carries
         only *-beta builds), so pinning "1.9.0" resolves with plain
         `dotnet restore` on some caches but fails NU1103 under the strict
         design-time restore that dotnet-ef performs. Pin the beta build
         that matches the 1.9.0 stable line used everywhere else. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.9.0-beta.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.9.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.9.0" />
    <!-- NOTE: OpenTelemetry.Instrumentation.SqlClient was dropped on
         purpose — it instruments Microsoft.Data.SqlClient (SQL Server),
         which this stack never uses. PostgreSQL spans come from Npgsql's
         built-in ActivitySource ("Npgsql"), enabled in
         Presentation/ObservabilityModule.cs with .AddSource("Npgsql"). -->
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Atlas.Shared.csproj" />
  </ItemGroup>
</Project>
